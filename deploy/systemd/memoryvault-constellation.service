[Unit]
Description=Constellation (LAN web UI)
After=network.target mnt-data.mount

[Service]
User=@USER@
Environment=MEMORYVAULT_LIBRARY_ROOT=@LIBRARY@
Environment=MEMORYVAULT_NSFW_MODEL_PATH=@NSFW@
ExecStart=/opt/memoryvault/venv/bin/python @REPO@/scripts/mvault constellation --port 8484 --tls-port 8485
Restart=on-failure

[Install]
WantedBy=multi-user.target
