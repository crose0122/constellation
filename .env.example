# Copy to .env and adjust. All values are optional — these are the defaults.

# Where YOUR photos live (mounted read-only; never modified).
MEMORYVAULT_SOURCE=./photos

# Host port for the Brain web UI.
MEMORYVAULT_PORT=8484

# Vision model (must be pulled into Ollama: `docker compose exec ollama ollama pull qwen2.5vl:7b`)
MEMORYVAULT_VISION_MODEL=qwen2.5vl:7b

# Vault mode. "dir" stores flagged/explicit content in a plain Docker volume —
# keep your Docker host on an ENCRYPTED disk. For true at-rest encryption run
# the vault as LUKS on the host instead (MEMORYVAULT_VAULT_MODE=luks) and see
# vault-ceremony.sh.
MEMORYVAULT_VAULT_MODE=dir

# Optional: email a photo from the gallery. Needs an app password.
# MEMORYVAULT_SMTP_USER=you@gmail.com
# MEMORYVAULT_SMTP_PASS=your-app-password
