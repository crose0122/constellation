{
  "name": "constellation-setup",
  "productName": "Constellation Setup",
  "version": "0.1.0",
  "description": "Constellation installer \u2014 one evening from a spare PC to your family photos on the wall. No GPU needed, no terminal, nothing leaves your network.",
  "homepage": "https://github.com/crose0122/constellation",
  "main": "main.js",
  "author": "Constellation",
  "license": "SEE LICENSE IN ../README.md",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "dist:linux": "chmod 0644 linux/apparmor/constellation-setup && electron-builder --linux deb AppImage"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.constellation.setup",
    "productName": "Constellation Setup",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "scan.js",
      "setup.js",
      "finish-install.js",
      "decide.js",
      "autostart.js",
      "ui/**"
    ],
    "extraResources": [
      {
        "from": "../scripts/dist/memoryvault-brain",
        "to": "backend"
      },
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Constellation Setup"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Graphics",
      "executableName": "constellation-setup",
      "maintainer": "Constellation"
    },
    "deb": {
      "depends": [
        "apparmor"
      ],
      "afterInstall": "linux/deb/after-install.sh",
      "afterRemove": "linux/deb/after-remove.sh",
      "fpm": [
        "linux/apparmor/constellation-setup=/etc/apparmor.d/constellation-setup"
      ]
    }
  }
}
